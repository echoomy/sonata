{
	"log": {
		"loglevel": "info"
	},
	"inbounds": [
		{
			"protocol": "tun"
		}
	],
	"outbounds": [
		{
			"protocol": "vless",
			"settings": {
				"vnext": [
					{
						"address": "${DOMAIN_NAME}",
						"port": 443,
						"users": [
							{
								"id": "${CLIENT_UUID}",
								"encryption": "none"
							}
						]
					}
				]
			},
			"streamSettings": {
				"network": "xhttp",
				"security": "reality",
				"realitySettings": {
					"serverName": "${DOMAIN_NAME}",
					"publicKey": "${PRIVATE_KEY}",
					"shortId": "${CLIENT_SHORT_ID}"
				},
				"xhttpSettings": {
					"path": "${CLIENT_XHTTP_PATH}",
					"mode": "auto"
				}
			}
		}
	]
}
